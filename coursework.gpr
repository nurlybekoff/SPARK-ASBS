with "config/coursework_config.gpr";
project Coursework is

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Coursework_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("test_asbs.adb");

   package Compiler is
      for Switches ("Ada") use ("-gnat2022");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Coursework;
